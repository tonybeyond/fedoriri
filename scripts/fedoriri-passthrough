#!/usr/bin/env python3
"""fedoriri-passthrough — neutralise les raccourcis niri pour Citrix/Shadow.

Pourquoi : xwayland-satellite ne relaie pas keyboard-shortcuts-inhibit
(issue #220) — une application X11 comme Citrix ou Shadow ne peut donc pas
demander elle-même au compositeur de lui laisser toutes les touches
(Alt+Tab, Super…). Niri n'a pas non plus de « modes » de binds. Il a en
revanche l'action toggle-keyboard-shortcuts-inhibit : ce démon écoute
`niri msg event-stream` et bascule l'inhibition quand le focus entre ou
sort d'une fenêtre cible (test d'acceptation n°9).

Limite assumée : si l'utilisateur bascule aussi à la main (Mod+Escape), les
états peuvent se désynchroniser d'un cran — le même Mod+Escape resynchronise
(le bind porte allow-inhibiting=false, il reste donc toujours actif).

Fenêtres cibles : expressions régulières sur app_id, une par ligne, dans
/etc/fedoriri/passthrough-apps puis ~/.config/fedoriri/passthrough-apps.
Défaut : wfica/citrix et shadow. Vérifier les app-id réels : `niri msg windows`.

Lancé par spawn-at-startup dans config.kdl.
"""

import json
import os
import re
import subprocess
import sys
import time

DEFAULT_PATTERNS = [r"(?i)wfica", r"(?i)citrix", r"(?i)^shadow"]


def load_patterns():
    patterns = []
    for path in ("/etc/fedoriri/passthrough-apps",
                 os.path.expanduser("~/.config/fedoriri/passthrough-apps")):
        try:
            with open(path, encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if line and not line.startswith("#"):
                        patterns.append(line)
        except OSError:
            continue
    return [re.compile(p) for p in (patterns or DEFAULT_PATTERNS)]


def toggle_inhibit():
    subprocess.run(["niri", "msg", "action", "toggle-keyboard-shortcuts-inhibit"],
                   check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def run(patterns):
    windows = {}          # id -> app_id
    inhibited = False     # état que CE démon a posé

    def is_target(win_id):
        app_id = windows.get(win_id) or ""
        return any(p.search(app_id) for p in patterns)

    proc = subprocess.Popen(["niri", "msg", "--json", "event-stream"],
                            stdout=subprocess.PIPE, text=True)
    assert proc.stdout is not None
    for line in proc.stdout:
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue

        if "WindowsChanged" in event:
            windows = {w["id"]: w.get("app_id") or ""
                       for w in event["WindowsChanged"]["windows"]}
        elif "WindowOpenedOrChanged" in event:
            w = event["WindowOpenedOrChanged"]["window"]
            windows[w["id"]] = w.get("app_id") or ""
        elif "WindowClosed" in event:
            windows.pop(event["WindowClosed"]["id"], None)

        # Détermine la fenêtre focalisée selon le type d'événement.
        focused = None
        if "WindowFocusChanged" in event:
            focused = event["WindowFocusChanged"].get("id")
        elif "WindowOpenedOrChanged" in event:
            w = event["WindowOpenedOrChanged"]["window"]
            if w.get("is_focused"):
                focused = w["id"]
        else:
            continue

        want = focused is not None and is_target(focused)
        if want != inhibited:
            toggle_inhibit()
            inhibited = want
    return proc.wait()


def main():
    if "--help" in sys.argv or "-h" in sys.argv:
        print(__doc__)
        return 0
    patterns = load_patterns()
    # Boucle de survie : si niri redémarre, on se ré-attache.
    while True:
        try:
            run(patterns)
        except (OSError, KeyboardInterrupt):
            return 0
        time.sleep(2)


if __name__ == "__main__":
    sys.exit(main())
