// config.kdl — configuration Niri de fedoriri.
//
// Keybinds calqués sur Omarchy autant que le modèle de niri le permet.
// Divergences assumées (niri = tuiles DÉFILANTES, Omarchy/Hyprland = tuiles
// classiques) — documentées dans docs/limites.md :
//   - pas de « workspaces grille » : les workspaces niri sont une colonne
//     verticale par sortie ; Mod+1..9 y accèdent quand même ;
//   - Mod+F reste « maximiser la colonne » (primitive centrale de niri),
//     le gestionnaire de fichiers est sur Mod+E ;
//   - pas d'animations désactivables PAR FENÊTRE (les window-rules niri ne
//     le permettent pas) — les animations restent globales.

input {
    keyboard {
        xkb {
            // Clavier Suisse romand.
            layout "ch"
            variant "fr"
        }
        repeat-delay 300
        repeat-rate 40
    }
    touchpad {
        tap
        natural-scroll
    }
    // Le focus suit la souris sans faire défiler la vue.
    focus-follows-mouse max-scroll-amount="0%"
}

// Moniteur : 1× 4K 60 Hz. Niri choisit automatiquement une échelle adaptée
// (2.0 pour un 4K typique). Pour forcer une valeur, décommenter :
// output "DP-1" {
//     mode "3840x2160@60.000"
//     scale 1.5
// }

layout {
    gaps 12
    center-focused-column "never"
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.5; }
    // FEDORIRI-THEME-BEGIN — bloc réécrit par fedoriri-theme-set, ne pas
    // éditer à la main entre ces marqueurs.
    focus-ring {
        width 2
        active-color "#7aa2f7"
        inactive-color "#414868"
    }
    border {
        off
    }
    // FEDORIRI-THEME-END
}

// Pas de barre de titre côté client : Omarchy-like, bordures fines.
prefer-no-csd

screenshot-path "~/Pictures/Screenshots/capture-%Y-%m-%d-%H%M%S.png"

environment {
    QT_QPA_PLATFORM "wayland"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    // niri >= 25.08 exporte DISPLAY lui-même et lance xwayland-satellite à
    // la demande (wiki niri, page Xwayland) : ne PAS le lancer ici, ne pas
    // fixer DISPLAY à la main.
}

// --- Démarrage de session ---------------------------------------------------
// Tire graphical-session.target (exigé par xdg-desktop-portal) : voir
// ~/.config/systemd/user/fedoriri-session.service. Lancé ici, APRÈS que niri
// a importé WAYLAND_DISPLAY & co dans systemd --user.
spawn-at-startup "systemctl" "--user" "start" "fedoriri-session.service"
spawn-at-startup "waybar"
spawn-at-startup "mako"
// Fond d'écran du thème courant (symlink géré par fedoriri-theme-set).
spawn-at-startup "sh" "-c" "swaybg -m fill -i \"$HOME/.config/fedoriri/background\""
// Verrouillage après 10 min d'inactivité, écran éteint après 15.
spawn-at-startup "swayidle" "-w" "timeout" "600" "swaylock -f" "timeout" "900" "niri msg action power-off-monitors" "before-sleep" "swaylock -f"
// Historique du presse-papiers.
spawn-at-startup "sh" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "sh" "-c" "wl-paste --type image --watch cliphist store"
// Agent polkit graphique (mate-polkit : polkit-gnome est absent de Fedora).
spawn-at-startup "/usr/libexec/polkit-mate-authentication-agent-1"
// Bascule automatique des raccourcis pour Citrix/Shadow (voir le script).
spawn-at-startup "fedoriri-passthrough"

// --- Règles de fenêtres : Citrix et Shadow ----------------------------------
// xwayland-satellite est rootless : ces clients X11 apparaissent comme des
// fenêtres Wayland normales avec l'app-id = classe X11 (vérifier avec
// `niri msg windows`). Plein écran sur UN moniteur — le plein écran Citrix
// multi-moniteurs est traité (et limité) dans docs/limites.md.
window-rule {
    match app-id=r#"(?i)wfica|citrix"#
    open-fullscreen true
    border { off; }
    focus-ring { off; }
}
window-rule {
    match app-id=r#"(?i)^shadow"#
    open-fullscreen true
    border { off; }
    focus-ring { off; }
    // VRR à la demande plutôt que permanent : n'active le taux variable que
    // quand Shadow est affiché (sans effet si la sortie n'a pas vrr on-demand).
    variable-refresh-rate true
}

binds {
    // --- Aide ---------------------------------------------------------------
    // Mod+F1 et non Mod+Shift+Slash : sur le clavier suisse romand, « / » est
    // déjà Shift+7 — la combinaison était intapable.
    Mod+F1 { show-hotkey-overlay; }

    // --- Applications (calqué Omarchy) --------------------------------------
    Mod+Return { spawn "alacritty"; }
    Mod+Space  { spawn "fuzzel"; }
    Mod+B      { spawn "brave-origin-stable"; }
    Mod+E      { spawn "nautilus"; }
    Mod+N      { spawn "alacritty" "-e" "nvim"; }
    Mod+T      { spawn "alacritty" "-e" "btop"; }
    Mod+Y      { spawn "fedoriri-theme-set" "--next"; }
    // Historique du presse-papiers.
    Mod+Shift+V { spawn "sh" "-c" "cliphist list | fuzzel --dmenu | cliphist decode | wl-copy"; }

    // --- Fenêtres -----------------------------------------------------------
    Mod+W       { close-window; }
    Mod+Q       { close-window; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+V       { toggle-window-floating; }
    Mod+O       { toggle-overview; }
    Mod+R       { switch-preset-column-width; }
    Mod+C       { center-column; }
    Mod+Comma   { consume-window-into-column; }
    Mod+Period  { expel-window-from-column; }

    // --- Focus (flèches et hjkl) --------------------------------------------
    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    // --- Déplacement --------------------------------------------------------
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+L     { move-column-right; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+J     { move-window-down; }

    // --- Workspaces ---------------------------------------------------------
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+Page_Down       { focus-workspace-down; }
    Mod+Page_Up         { focus-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+Shift+Page_Up   { move-column-to-workspace-up; }

    // --- Captures d'écran ---------------------------------------------------
    Print      { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print  { screenshot-window; }
    // Annotation : capture de zone vers swappy (satty est absent de Fedora).
    Mod+Shift+S { spawn "sh" "-c" "grim -g \"$(slurp)\" - | swappy -f -"; }

    // --- Citrix / Shadow : bascule manuelle des raccourcis ------------------
    // allow-inhibiting=false : ce bind reste actif MÊME quand l'inhibition
    // est en place — c'est la porte de sortie (et de resynchronisation du
    // démon fedoriri-passthrough).
    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }

    // --- Système ------------------------------------------------------------
    Mod+Alt+L allow-inhibiting=false { spawn "swaylock" "-f"; }
    Mod+Shift+P { power-off-monitors; }
    Mod+Shift+E { quit; }
    Ctrl+Alt+Delete { quit; }

    // --- Multimédia (actifs même écran verrouillé) --------------------------
    XF86AudioRaiseVolume allow-when-locked=true { spawn "pamixer" "-i" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "pamixer" "-d" "5"; }
    XF86AudioMute        allow-when-locked=true { spawn "pamixer" "-t"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "pamixer" "--default-source" "-t"; }
    XF86AudioPlay        allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "playerctl" "previous"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }
}
