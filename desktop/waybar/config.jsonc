// Waybar fedoriri — barre unique en haut, esthétique Omarchy (option B).
// Les couleurs vivent dans colors.css, généré par fedoriri-theme-set.
//
// Les icônes sont écrites en échappements JSON \uXXXX (jamais en glyphes
// littéraux) : un éditeur ou un outil qui ne sait pas afficher la zone
// d'usage privé les avait silencieusement supprimés — la barre n'affichait
// plus que « 40 % » et « 0 % » (constaté sur matériel le 2026-08-21). Tous
// les codepoints ci-dessous sont couverts par Font Awesome 6 Free ET par
// Cascadia Mono NF (paquets Fedora, donc disponibles hors ligne) —
// vérifié avec `fc-list ":charset=XXXX"` sur le système installé.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 6,

  "modules-left": ["niri/workspaces", "niri/window"],
  "modules-center": ["clock"],
  "modules-right": ["tray", "bluetooth", "network", "pulseaudio", "cpu", "custom/theme"],

  "niri/workspaces": {
    "format": "{icon}",
    // U+F192 dot-circle (actif), U+F111 circle (autres).
    "format-icons": { "active": "\uf192", "default": "\uf111" }
  },
  "niri/window": {
    "max-length": 60,
    "separate-outputs": true
  },
  "clock": {
    // Formats fr_CH : jour.mois.année, heure 24 h.
    "format": "{:%H:%M}",
    "format-alt": "{:%A %d.%m.%Y  %H:%M}",
    "tooltip-format": "<tt>{calendar}</tt>"
  },
  "tray": { "icon-size": 16, "spacing": 8 },
  "bluetooth": {
    // U+F293 bluetooth-b (Font Awesome 6 Brands / Nerd Font).
    "format": "\uf293",
    "format-disabled": "",
    "format-connected": "\uf293 {num_connections}",
    "on-click": "alacritty -e bluetoothctl"
  },
  "network": {
    // U+F1EB wifi, U+F6FF ethernet, U+F127 chain-broken.
    "format-wifi": "\uf1eb  {signalStrength}%",
    "format-ethernet": "\uf6ff",
    "format-disconnected": "\uf127",
    "tooltip-format": "{ifname} — {ipaddr}",
    "on-click": "alacritty -e nmtui"
  },
  "pulseaudio": {
    // U+F028/F027/F026 volume-high/low/off, U+F6A9 volume-xmark.
    "format": "{icon} {volume}%",
    "format-muted": "\uf6a9 ",
    "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
    "on-click": "pamixer -t"
  },
  "cpu": {
    // U+F2DB microchip.
    "format": "\uf2db {usage}%",
    "interval": 5,
    "on-click": "alacritty -e btop"
  },
  "custom/theme": {
    // U+F53F palette.
    "format": "\uf53f",
    "tooltip": false,
    "on-click": "fedoriri-theme-set --next"
  }
}
