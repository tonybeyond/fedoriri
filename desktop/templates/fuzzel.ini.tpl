# Généré par fedoriri-theme-set — ne pas éditer à la main.
[main]
font=JetBrains Mono:size=12
prompt="❯ "
icon-theme=Papirus
layer=overlay
width=40
lines=10
horizontal-pad=20
vertical-pad=12

[colors]
background={{ background_strip }}ee
text={{ foreground_strip }}ff
prompt={{ dark_foreground_strip }}ff
match={{ accent_strip }}ff
selection={{ selection_strip }}ff
selection-text={{ bright_foreground_strip }}ff
selection-match={{ accent_strip }}ff
border={{ accent_strip }}ff

[border]
width=2
radius=8
